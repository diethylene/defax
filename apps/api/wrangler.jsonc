{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "defax-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "vars": {
    "APP_VERSION": "0.0.0"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_classes": ["Room"] }]
}
