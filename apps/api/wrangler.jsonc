{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "defax-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "vars": {
    "APP_VERSION": "0.0.0",
    "RATE_LIMIT_DEFAULT": "30",
    "RATE_LIMIT_WINDOW": "1 minute",
    "ALLOWED_ORIGIN": "https://defax.axelson.gg"
  },
  "secrets": {
    "required": ["TURN_KEY_ID", "TURN_KEY_API_TOKEN"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiterDo" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["RateLimiterDo"] }
  ]
}
