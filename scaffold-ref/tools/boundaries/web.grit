JsModuleSource() as $source where {
  $source <: or {
    r"['\"]@api/.*['\"]",
    r"['\"]effect/http['\"]",
    r"['\"]effect/http/.*['\"]",
    r"['\"]effect/http-api['\"]",
    r"['\"]effect/http-api/.*['\"]",
    r"['\"]effect/Effect['\"]",
    r"['\"]effect/Layer['\"]",
    r"['\"]effect/Stream['\"]"
  },
  register_diagnostic(span=$source, message="Boundary: the web app never imports the API app or the Effect runtime. Share code through @contract; Angular does HTTP, DI, and async.")
}
