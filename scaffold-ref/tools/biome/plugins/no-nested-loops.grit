or {
  JsForStatement(body=$body),
  JsForOfStatement(body=$body),
  JsForInStatement(body=$body),
  JsWhileStatement(body=$body),
  JsDoWhileStatement(body=$body)
} as $loop where {
  $body <: contains or {
    JsForStatement(),
    JsForOfStatement(),
    JsForInStatement(),
    JsWhileStatement(),
    JsDoWhileStatement()
  },
  register_diagnostic(span=$loop, message="No nested loops. Use flatMap, or build a Map index and look up (design: Functional style).")
}
