{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "plugins": [
    {
      "path": "./plugins/no-switch.grit",
      "resolutionKind": "config"
    },
    {
      "path": "./plugins/no-nested-if.grit",
      "resolutionKind": "config"
    },
    {
      "path": "./plugins/max-two-guards.grit",
      "resolutionKind": "config"
    },
    {
      "path": "./plugins/no-compound-guards.grit",
      "resolutionKind": "config"
    },
    {
      "path": "./plugins/no-nested-loops.grit",
      "resolutionKind": "config"
    },
    {
      "path": "./plugins/no-let.grit",
      "resolutionKind": "config"
    },
    {
      "path": "./plugins/no-function-declarations.grit",
      "resolutionKind": "config"
    }
  ],
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noEnum": "error",
        "noNestedTernary": "error",
        "noUselessElse": "error",
        "noNonNullAssertion": "error",
        "noDefaultExport": "error",
        "noNamespace": "error",
        "noParameterAssign": "error",
        "useConst": "error",
        "useImportType": "error",
        "useExportType": "error",
        "useReadonlyClassProperties": "error",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "interface"
          }
        },
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        },
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"],
            "requireAscii": true
          }
        },
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "lodash": "Use Effect's Array, Record, and pipe (typescript: Effect as the standard library).",
              "lodash-es": "Use Effect's Array, Record, and pipe (typescript: Effect as the standard library).",
              "ramda": "Use Effect's pipe and modules (typescript: Effect as the standard library).",
              "remeda": "Use Effect's pipe and modules (typescript: Effect as the standard library).",
              "zod": "Use Effect Schema (typescript: Effect as the standard library).",
              "neverthrow": "Use Effect Result (typescript: Effect as the standard library).",
              "ts-pattern": "Use Effect Match (typescript: Effect as the standard library).",
              "effect": "Import the module directly (effect/Schema, effect/Option; pipe from effect/Function). The barrel import defeats tree-shaking (typescript: Effect as the standard library)."
            }
          }
        },
        "noProcessEnv": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noTsIgnore": "error",
        "noImportCycles": "error",
        "noEvolvingTypes": "error",
        "noImplicitAnyLet": "error",
        "noVar": "error"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      },
      "performance": {
        "noBarrelFile": "error",
        "noReExportAll": "error",
        "noAccumulatingSpread": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/features/*/index.ts", "**/features/*/features/*/index.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off",
            "noReExportAll": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.config.ts", "**/*.config.mts", "**/*.stories.ts", "**/.storybook/**"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
