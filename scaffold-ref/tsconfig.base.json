{
  "compileOnSave": false,
  "extends": "./tools/tsconfig/base.json",
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom"],
    "importHelpers": true,
    "experimentalDecorators": true,
    "paths": {
      "@contract/*": ["./libs/contract/src/*"],
      "@web/core/*": ["./apps/web/src/app/core/*"],
      "@web/shared/*": ["./apps/web/src/app/shared/*"],
      "@web/features/*": ["./apps/web/src/app/features/*"],
      "@web/store/*": ["./apps/web/src/app/store/*"],
      "@api/core/*": ["./apps/api/src/core/*"],
      "@api/features/*": ["./apps/api/src/features/*"],
      "@spartan-ng/helm/button": ["./libs/ui/button/src/index.ts"],
      "@spartan-ng/helm/utils": ["./libs/ui/utils/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
