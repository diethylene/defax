JsModuleSource() as $source where {
  $source <: or {
    r"['\"]@web/.*['\"]",
    r"['\"]@api/.*['\"]",
    r"['\"]@spartan-ng/.*['\"]",
    r"['\"]@angular/.*['\"]",
    r"['\"]@ngrx/.*['\"]",
    r"['\"]rxjs['\"]",
    r"['\"]rxjs/.*['\"]",
    r"['\"]effect/http['\"]",
    r"['\"]effect/http/.*['\"]",
    r"['\"]effect/http-api['\"]",
    r"['\"]effect/http-api/.*['\"]"
  },
  register_diagnostic(span=$source, message="Boundary: the contract holds schemas only. No app, UI, framework, or HTTP imports.")
}
