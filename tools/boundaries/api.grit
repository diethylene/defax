JsModuleSource() as $source where {
  $source <: or {
    r"['\"]@web/.*['\"]",
    r"['\"]@spartan-ng/.*['\"]",
    r"['\"]@angular/.*['\"]",
    r"['\"]@ngrx/.*['\"]",
    r"['\"]rxjs['\"]",
    r"['\"]rxjs/.*['\"]"
  },
  register_diagnostic(span=$source, message="Boundary: the API app never imports web, UI, Angular, or RxJS code. Share code through @contract.")
}
