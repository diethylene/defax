pattern guard() {
  JsIfStatement(else_clause=., consequent=or {
    JsReturnStatement(),
    JsThrowStatement(),
    JsBlockStatement(statements=[
      or {
        JsReturnStatement(),
        JsThrowStatement()
      },
    ])
  })
}

or {
  JsFunctionBody(statements=$statements),
  JsBlockStatement(statements=$statements)
} where {
  $statements <: [..., guard() as $first, guard(), guard(), ...],
  register_diagnostic(span=$first, message="More than two consecutive guard clauses. Parse at the boundary into a type, or match instead (design: Control flow).")
}
