{
  "extends": ["./tools/biome/base.json"],
  "files": {
    "includes": [
      "**",
      "!libs/ui",
      "!apps/web",
      "!dist",
      "!.nx",
      "!.angular",
      "!apps/api/worker-configuration.d.ts",
      "!pnpm-lock.yaml",
      "!pnpm-workspace.yaml",
      "!README.md"
    ]
  },
  "plugins": [
    { "path": "./tools/boundaries/web.grit", "includes": ["apps/web/**"] },
    { "path": "./tools/boundaries/api.grit", "includes": ["apps/api/**"] },
    { "path": "./tools/boundaries/contract.grit", "includes": ["libs/contract/**"] }
  ],
  "overrides": [
    {
      "includes": ["apps/api/src/worker.ts"],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    }
  ]
}
